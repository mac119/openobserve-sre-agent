# OpenObserve SRE Agent — environment template
# Copy to .env and fill in your own values. .env is gitignored (never commit it).

# OpenObserve API — service account (the ONLY credential valid for API access).
# Use a service account's Basic token, NOT an ingestion token.
OPENOBSERVE_BASE_URL=http://your-openobserve-host:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_AUTH=Basic <base64(email:token)>

# LLM provider (OpenAI-compatible). DashScope example:
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=qwen-max
LLM_PROVIDER=openai
LLM_BASE_URL=https://your-llm-gateway/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o
# Optional comma-separated fallback models tried in order when the primary is
# rate-limited (429) or errors (5xx). Lets the agent survive per-model limits.
# LLM_FALLBACK_MODELS=gpt-4.1,vertex_ai/gemini-2.5-flash,gpt-4.1-mini

# Cost telemetry: USD per 1M tokens
# LLM_PRICE_IN_PER_MTOK=3.0
# LLM_PRICE_OUT_PER_MTOK=15.0
# O2_LOG_ECHO=0

# Safety budgets
O2_MAX_ROWS=1000
O2_SCAN_RECORDS_BUDGET=5000000
O2_HTTP_TIMEOUT=30

# Phase 8 security controls
# Comma-separated allowed hosts; empty = unrestricted. When set, the client
# refuses any base_url whose host is not listed.
# O2_ENDPOINT_ALLOWLIST=your-openobserve-host
# Conversation/memory retention in days; 0 keeps everything. Older sessions are
# purged on agent startup.
O2_RETENTION_DAYS=0
# At-rest encryption of stored conversation memory. Set a passphrase to encrypt
# message content / tool summaries / context in the SQLite DB (needs the
# 'cryptography' package). Empty = plaintext (backward compatible).
# O2_MEMORY_KEY=change-me-to-a-long-random-passphrase

# Context management (P0-1 result trimming/offload)
# Rows shown inline as a sample before a large result is offloaded to the result
# store (the model pages the rest via fetch_result).
O2_RESULT_SAMPLE_ROWS=5
# Payload byte size above which a result is offloaded instead of inlined.
O2_RESULT_INLINE_MAX_BYTES=2048

# Context management (P0-2 compaction)
# Rough chars-per-token for the size estimate; history is compacted when its
# estimated tokens exceed O2_CONTEXT_TOKEN_BUDGET * O2_COMPACT_RATIO.
O2_TOKENS_PER_CHAR=4
O2_CONTEXT_TOKEN_BUDGET=128000
O2_COMPACT_RATIO=0.7
# Number of most-recent turns kept verbatim (older turns become a summary).
O2_KEEP_RECENT_TURNS=3

# Loop control (P1)
# Block an identical (tool, args) call after this many repeats in one turn.
O2_MAX_REPEAT_CALLS=2
# Per-turn budgets; 0 disables. The turn stops gracefully if exceeded.
O2_TURN_COST_BUDGET_USD=0
O2_TURN_WALL_CLOCK_S=0

# Cost & latency (P2)
# Run read-only tool calls in a turn concurrently (writes stay serial).
O2_PARALLEL_TOOLS=1
O2_MAX_PARALLEL=4
# Optional model routing by intent; empty = always use LLM_MODEL.
# O2_MODEL_SMALL=your-small-model
# O2_MODEL_LARGE=your-large-model

# HTTP/SSE API server (Phase 12)
O2_API_HOST=127.0.0.1
O2_API_PORT=8799
# Bearer token to protect the API; empty = OPEN (dev only). Health is always open.
# O2_API_TOKEN=change-me
# CORS allowed origin for the front-end; default * (tighten in production).
O2_CORS_ORIGIN=*

# Long-term memory (cross-session, per-org; see memory-longterm.md)
O2_LTM_ENABLED=1
O2_LTM_MAX_PER_ORG=100        # capacity cap per org (evicts lowest importance/oldest)
O2_LTM_INJECT_TOP=20          # how many memories to inject into context per turn
O2_LTM_DEFAULT_TTL_DAYS=0     # default expiry for new items (0 = never)

# Storage backend (storage-backend.md)
# Empty = embedded SQLite (default, no dependency). A postgresql:// URL selects
# the Postgres backend (Phase 2, not yet implemented).
O2_DB_URL=
# O2_DB_PATH=~/.o2agent/memory.db   # SQLite file location (optional)
O2_DB_POOL_MAX=8                    # Postgres connection-pool size (Phase 2)
